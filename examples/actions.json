{
  "_comment": "游戏动作清单正式模板（v2026-08-23）— 新游戏照着填表接入，零代码。actions 必填；resources 可选（对话接单的资源词典+别名；不填则从世界 locations 动态收集）。tier: 1低/2中/3高影响; approval: allow/ask/deny。",
  "actions": {
    "gather": {
      "tier": 1,
      "approval": "allow",
      "params": ["resource", "count"],
      "desc": "采集资源（只影响自己背包）"
    },
    "craft": {
      "tier": 2,
      "approval": "ask",
      "params": ["recipe", "count"],
      "desc": "制作（改变自身持有）"
    },
    "deliver": {
      "tier": 3,
      "approval": "ask",
      "params": ["resource", "count"],
      "desc": "交付（改变玩家/世界，最高影响）"
    },
    "move": {
      "tier": 2,
      "approval": "ask",
      "params": ["x", "z"],
      "desc": "移动（改变自身位置）"
    }
  },
  "resources": {
    "木材": ["木头", "柴", "木料", "原木", "木", "树"],
    "浆果": ["果子", "野果", "果实"],
    "石头": ["岩石", "石块", "石"]
  }
}
